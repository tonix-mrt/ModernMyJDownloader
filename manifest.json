{
  "description": "__MSG_extensionDescription__",
  "manifest_version": 3,
  "name": "ModernMyJDownloader",
  "short_name": "ModernMyJDownloader",
  "version": "1.0.3",
  "author": "AppWork GmbH",
  "homepage_url": "https://my.jdownloader.org",
  "icons": {
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "webRequest",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    },
    "default_title": "ModernMyJDownloader",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "index.html#!/settings",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "toolbar.html",
        "autograbber-indicator.html",
        "loginNeeded.html",
        "res/browser_solver_template.html",
        "images/*",
        "buildMeta.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "commands": {
    "toggle-clipboard-observer": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "__MSG_toggle_clipboard_observer__"
    },
    "auto-grab-downloads": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_toggle_auto_grab_links__"
    }
  },
  "content_scripts": [
    {
      "js": [
        "contentscripts/rc2Contentscript.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "js": [
        "contentscripts/rc2LoadingIndicator.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "js": [
        "contentscripts/onCopyContentscript.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "js": [
        "contentscripts/toolbarContentscript.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "js": [
        "contentscripts/selectionContentscript.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "js": [
        "contentscripts/webinterfaceEnhancer.js"
      ],
      "run_at": "document_end",
      "all_frames": true,
      "matches": [
        "http://my.jdownloader.org/*",
        "https://my.jdownloader.org/*"
      ]
    }
  ],
  "default_locale": "en"
}
